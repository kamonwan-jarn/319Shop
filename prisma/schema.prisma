generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED

  @@map("order_status")
}

model User {
  id           String        @id @default(cuid()) @map("id")
  name         String        @map("name")
  email        String        @unique @map("email")
  passwordHash String        @map("password_hash")
  createdAt    DateTime      @default(now()) @map("created_at")
  /// เซสชันทั้งหมดของผู้ใช้
  sessions     AuthSession[]
  /// รายการสินค้าที่ผู้ใช้ชอบ
  wishlist     WishlistItem[]
  /// สินค้าในรถเข็นของผู้ใช้
  cart         CartItem[]
  /// ประวัติคำสั่งซื้อของผู้ใช้
  orders       Order[]

  @@map("users")
}

model AuthSession {
  id        String   @id @default(cuid()) @map("id")
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  /// เซสชันเป็นของผู้ใช้ ลบตามผู้ใช้
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model WishlistItem {
  id        String   @id @default(cuid()) @map("id")
  userId    String   @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  /// รายการถูกใจลบตามผู้ใช้
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ใช้แคชสินค้าแสดงรายการถูกใจ
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}

model CartItem {
  id        String   @id @default(cuid()) @map("id")
  userId    String   @map("user_id")
  productId Int      @map("product_id")
  quantity  Int      @default(1) @map("quantity")
  updatedAt DateTime @updatedAt @map("updated_at")
  /// สินค้าในรถเข็นลบตามผู้ใช้
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ใช้แคชสินค้าแสดงรถเข็น
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id              String      @id @default(cuid()) @map("id")
  userId          String      @map("user_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  totalAmount     Decimal     @db.Decimal(10, 2) @map("total_amount")
  status          OrderStatus @default(PAID) @map("status")
  shippingName    String      @map("shipping_name")
  shippingPhone   String      @map("shipping_phone")
  shippingAddress Json        @map("shipping_address")
  paymentMethod   String      @map("payment_method")
  /// ประวัติคำสั่งซื้อผูกกับผู้ใช้
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// รายการสินค้าพร้อมข้อมูล ณ เวลาสั่งซื้อ
  items           OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid()) @map("id")
  orderId     String  @map("order_id")
  productId   Int     @map("product_id")
  productName String  @map("product_name")
  unitPrice   Decimal @db.Decimal(10, 2) @map("unit_price")
  quantity    Int     @map("quantity")
  /// รายการย่อยลบตามคำสั่งซื้อ
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@index([orderId])
  @@map("order_items")
}

model Product {
  id         Int           @id @map("id")
  name       String        @map("name")
  price      Decimal       @db.Decimal(10, 2) @map("price")
  imageUrl   String        @map("image_url")
  category   String        @map("category")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  /// รายการ wishlist ที่ใช้สินค้าแคชนี้
  wishlisted WishlistItem[]
  /// รายการรถเข็นที่ใช้สินค้าแคชนี้
  cartItems  CartItem[]

  @@map("products")
}
